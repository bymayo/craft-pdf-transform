{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("bymayo\\pdftransform\\assetbundles\\PdfTransform\\PdfTransformAsset") %}

{{ forms.textField({
    label: 'Page Number',
    instructions: 'The page number to render.',
    id: 'page',
    name: 'page',
    value: settings['page'],
    required: true
    })
}}

{{ forms.selectField({
    label: 'Output Image Volume',
    instructions: 'The volume you want to output renders to',
    id: 'imageVolume',
    name: 'imageVolume',
    value: settings['imageVolume'],
    required: true,
    options: volumes
    })
}}

{{ forms.textField({
    label: 'Image Resolution',
    id: 'imageResolution',
    name: 'imageResolution',
    value: settings['imageResolution'],
    required: true
    })
}}

{{ forms.textField({
    label: 'Image Quality',
    id: 'imageQuality',
    name: 'imageQuality',
    value: settings['imageQuality'],
    required: true
    })
}}

{{ forms.lightswitchField({
    label: 'Clean Filenames',
    instructions: 'Remove <code>.pdf</code> from output filenames. Enabling this will regenerate existing files on next render.',
    id: 'cleanFilenames',
    name: 'cleanFilenames',
    on: settings['cleanFilenames']
    })
}}

{{ forms.selectField({
    label: 'Colour Space',
    instructions: 'sRGB fixes inverted colours on CMYK PDFs.',
    id: 'imageColorspace',
    name: 'imageColorspace',
    value: settings['imageColorspace'],
    required: true,
    options: [
      {
        'label': 'sRGB (Recommended)',
        'value': 'srgb'
      },
      {
        'label': 'RGB',
        'value': 'rgb'
      },
      {
        'label': 'CMYK',
        'value': 'cmyk'
      },
      {
        'label': 'Grayscale',
        'value': 'gray'
      },
      {
        'label': 'None',
        'value': 'none'
      }
    ]
    })
}}

{{ forms.selectField({
    label: 'Image Format',
    id: 'imageFormat',
    name: 'imageFormat',
    value: settings['imageFormat'],
    required: true,
    options: [
      {
        'label': 'JPEG (.jpg)',
        'value': 'jpg'
      },
      {
        'label': 'PNG (.png)',
        'value': 'png'
      }
    ]
    })
}}