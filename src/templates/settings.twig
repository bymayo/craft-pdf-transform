{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("bymayo\\pdftransform\\assetbundles\\PdfTransform\\PdfTransformAsset") %}

{{ forms.textField({
    label: 'Page Number',
    instructions: 'The page number to render.',
    id: 'page',
    name: 'page',
    value: settings['page'],
    required: true
    })
}}

{{ forms.selectField({
    label: 'Output Image Volume',
    instructions: 'The volume you want to output renders to',
    id: 'imageVolume',
    name: 'imageVolume',
    value: imageVolumeValue,
    required: true,
    errors: settings.getErrors('imageVolume'),
    options: [{ label: 'Select a volume…', value: '' }]|merge(volumes)
    })
}}

{{ forms.selectField({
    label: 'Output Destination',
    instructions: 'Where within the output volume to place generated images.',
    id: 'imageDestination',
    name: 'imageDestination',
    value: settings['imageDestination'],
    required: true,
    options: [
      {
        'label': 'Volume Root (Default)',
        'value': 'root'
      },
      {
        'label': 'Subfolder',
        'value': 'subfolder'
      },
      {
        'label': 'Mirror Source Path',
        'value': 'mirror'
      }
    ]
    })
}}

<div class="js-subfolder-toggle{% if settings['imageDestination'] != 'subfolder' %} hidden{% endif %}">
  {{ forms.textField({
      label: 'Subfolder Name',
      instructions: 'The subfolder within the output volume to place generated images (e.g. <code>thumbnails</code>).',
      id: 'imageSubfolder',
      name: 'imageSubfolder',
      value: settings['imageSubfolder']
      })
  }}
</div>

{{ forms.textField({
    label: 'Image Resolution',
    id: 'imageResolution',
    name: 'imageResolution',
    value: settings['imageResolution'],
    required: true
    })
}}

{{ forms.textField({
    label: 'Image Quality',
    id: 'imageQuality',
    name: 'imageQuality',
    value: settings['imageQuality'],
    required: true
    })
}}

{{ forms.lightswitchField({
    label: 'Clean Filenames',
    instructions: 'Remove <code>.pdf</code> from output filenames. Enabling this will regenerate existing files on next render.',
    id: 'cleanFilenames',
    name: 'cleanFilenames',
    on: settings['cleanFilenames']
    })
}}

{{ forms.selectField({
    label: 'Colour Space',
    instructions: 'sRGB fixes inverted colours on CMYK PDFs.',
    id: 'imageColorspace',
    name: 'imageColorspace',
    value: settings['imageColorspace'],
    required: true,
    options: [
      {
        'label': 'sRGB (Recommended)',
        'value': 'srgb'
      },
      {
        'label': 'RGB',
        'value': 'rgb'
      },
      {
        'label': 'CMYK',
        'value': 'cmyk'
      },
      {
        'label': 'Grayscale',
        'value': 'gray'
      },
      {
        'label': 'None',
        'value': 'none'
      }
    ]
    })
}}

{{ forms.selectField({
    label: 'Image Format',
    id: 'imageFormat',
    name: 'imageFormat',
    value: settings['imageFormat'],
    required: true,
    options: [
      {
        'label': 'JPEG (.jpg)',
        'value': 'jpg'
      },
      {
        'label': 'PNG (.png)',
        'value': 'png'
      }
    ]
    })
}}

<hr>

{{ forms.checkboxSelectField({
    label: 'Auto-Transform Source Volumes',
    instructions: 'Select which volumes trigger auto-transform when a PDF is uploaded. This does not affect the <code>craft.pdfTransform.render()</code> Twig method.',
    id: 'sourceVolumes',
    name: 'sourceVolumes',
    values: sourceVolumeValues,
    options: volumes,
    showAllOption: true
    })
}}

<hr>

{% css %}
    /* Strip .pane's default inner padding so the table fits flush. */
    .pdf-transform-status-table.pane {
        padding: 0;
        overflow: hidden;
    }
    /* Craft sets row borders to transparent by default — colour them in. */
    .pdf-transform-status-table tbody tr:not(:last-child) > th,
    .pdf-transform-status-table tbody tr:not(:last-child) > td {
        border-bottom: 1px solid var(--hairline-color);
    }
    /* Craft has no condensed table variant; tighten the cell padding. */
    .pdf-transform-status-table table.data td,
    .pdf-transform-status-table table.data th {
        padding-block: 5px;
        padding-inline: 10px;
        font-size: 13px;
    }
{% endcss %}

<h2>Status</h2>

<p>Checked in the same PHP process that renders your site.</p>

<div class="pane hairline pdf-transform-status-table" style="max-width: 640px;">
    <table class="data fullwidth">
        <tbody>
            {% for check in environmentStatus %}
                <tr>
                    <th>{{ check.label }}</th>
                    <td>
                        <span class="status {{ check.ok ? 'green' : 'red' }}"></span>
                        {{ check.detail }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<p class="light">Failed transforms are logged to <code>storage/logs/pdfTransform.log</code>.</p>

{% js %}
(function() {
  var destinationSelect = document.querySelector('select[name$="[imageDestination]"]');
  var subfolderWrapper = document.querySelector('.js-subfolder-toggle');
  if (destinationSelect && subfolderWrapper) {
    destinationSelect.addEventListener('change', function() {
      if (this.value === 'subfolder') {
        subfolderWrapper.classList.remove('hidden');
      } else {
        subfolderWrapper.classList.add('hidden');
      }
    });
  }
})();
{% endjs %}