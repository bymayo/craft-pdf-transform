{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("bymayo\\pdftransform\\assetbundles\\PdfTransform\\PdfTransformAsset") %}

{{ forms.textField({
    label: 'Page Number',
    instructions: 'The page number to render.',
    id: 'page',
    name: 'page',
    value: settings['page'],
    required: true
    })
}}

{{ forms.selectField({
    label: 'Output Image Volume',
    instructions: 'The volume you want to output renders to',
    id: 'imageVolume',
    name: 'imageVolume',
    value: settings['imageVolume'],
    required: true,
    options: volumes
    })
}}

{{ forms.textField({
    label: 'Image Resolution',
    id: 'imageResolution',
    name: 'imageResolution',
    value: settings['imageResolution'],
    required: true
    })
}}

{{ forms.textField({
    label: 'Image Quality',
    id: 'imageQuality',
    name: 'imageQuality',
    value: settings['imageQuality'],
    required: true
    })
}}

{{ forms.selectField({
    label: 'Image Format',
    id: 'imageFormat',
    name: 'imageFormat',
    value: settings['imageFormat'],
    required: true,
    options: [
      {
        'label': 'JPEG (.jpg)',
        'value': 'jpg'
      },
      {
        'label': 'PNG (.png)',
        'value': 'png'
      }
    ]
    })
}}

<div class="readable" style="margin-top: 24px;">
    <blockquote class="note warning">
        <p>Since v5.0.2, transformed images use a new naming format (e.g. <code>document-123.jpg</code> instead of <code>document.pdf-123.jpg</code>). Existing transformed images will be regenerated with the new format on next render. Old files can be manually removed from your output volume.</p>
    </blockquote>
</div>
