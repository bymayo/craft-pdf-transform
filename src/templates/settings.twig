{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("bymayo\\pdftransform\\assetbundles\\PdfTransform\\PdfTransformAsset") %}

{{ forms.textField({
    label: 'Page Number',
    instructions: 'The page number to render.',
    id: 'page',
    name: 'page',
    value: settings['page'],
    required: true
    })
}}

{{ forms.selectField({
    label: 'Output Image Volume',
    instructions: 'The volume you want to output renders to',
    id: 'imageVolume',
    name: 'imageVolume',
    value: settings['imageVolume'],
    required: true,
    options: volumes
    })
}}

{{ forms.selectField({
    label: 'Output Destination',
    instructions: 'Where within the output volume to place generated images.',
    id: 'imageDestination',
    name: 'imageDestination',
    value: settings['imageDestination'],
    required: true,
    options: [
      {
        'label': 'Volume Root (Default)',
        'value': 'root'
      },
      {
        'label': 'Subfolder',
        'value': 'subfolder'
      },
      {
        'label': 'Mirror Source Path',
        'value': 'mirror'
      }
    ]
    })
}}

<div id="{{ 'imageSubfolder-wrapper'|namespaceInputId }}"{% if settings['imageDestination'] != 'subfolder' %} class="hidden"{% endif %}>
  {{ forms.textField({
      label: 'Subfolder Name',
      instructions: 'The subfolder within the output volume to place generated images (e.g. <code>thumbnails</code>).',
      id: 'imageSubfolder',
      name: 'imageSubfolder',
      value: settings['imageSubfolder']
      })
  }}
</div>

{{ forms.textField({
    label: 'Image Resolution',
    id: 'imageResolution',
    name: 'imageResolution',
    value: settings['imageResolution'],
    required: true
    })
}}

{{ forms.textField({
    label: 'Image Quality',
    id: 'imageQuality',
    name: 'imageQuality',
    value: settings['imageQuality'],
    required: true
    })
}}

{{ forms.lightswitchField({
    label: 'Clean Filenames',
    instructions: 'Remove <code>.pdf</code> from output filenames. Enabling this will regenerate existing files on next render.',
    id: 'cleanFilenames',
    name: 'cleanFilenames',
    on: settings['cleanFilenames']
    })
}}

{{ forms.selectField({
    label: 'Colour Space',
    instructions: 'sRGB fixes inverted colours on CMYK PDFs.',
    id: 'imageColorspace',
    name: 'imageColorspace',
    value: settings['imageColorspace'],
    required: true,
    options: [
      {
        'label': 'sRGB (Recommended)',
        'value': 'srgb'
      },
      {
        'label': 'RGB',
        'value': 'rgb'
      },
      {
        'label': 'CMYK',
        'value': 'cmyk'
      },
      {
        'label': 'Grayscale',
        'value': 'gray'
      },
      {
        'label': 'None',
        'value': 'none'
      }
    ]
    })
}}

{{ forms.selectField({
    label: 'Image Format',
    id: 'imageFormat',
    name: 'imageFormat',
    value: settings['imageFormat'],
    required: true,
    options: [
      {
        'label': 'JPEG (.jpg)',
        'value': 'jpg'
      },
      {
        'label': 'PNG (.png)',
        'value': 'png'
      }
    ]
    })
}}

<hr>

{{ forms.checkboxSelectField({
    label: 'Auto-Transform Source Volumes',
    instructions: 'Select which volumes trigger auto-transform when a PDF is uploaded.',
    id: 'sourceVolumes',
    name: 'sourceVolumes',
    values: settings['sourceVolumes'],
    options: volumes,
    showAllOption: true
    })
}}

{% js %}
(function() {
  var destinationSelect = document.getElementById('{{ "imageDestination"|namespaceInputId }}');
  var subfolderWrapper = document.getElementById('{{ "imageSubfolder-wrapper"|namespaceInputId }}');
  if (destinationSelect && subfolderWrapper) {
    destinationSelect.addEventListener('change', function() {
      if (this.value === 'subfolder') {
        subfolderWrapper.classList.remove('hidden');
      } else {
        subfolderWrapper.classList.add('hidden');
      }
    });
  }
})();
{% endjs %}